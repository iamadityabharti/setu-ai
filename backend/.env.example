# Backend Environment Variables
PROJECT_NAME="SETU AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="setu-ai-brics-super-secret-jwt-key-2026-production-ready"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default SQLite async URL for zero-friction local run:
DATABASE_URL="sqlite+aiosqlite:///./setu_ai.db"

# Or for PostgreSQL with PostGIS & pgvector:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/setu_ai"
